# ───────────── Site ─────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────────── Payment switch ─────────────
# disabled  → donate button says "opening soon" (default; nothing can be charged)
# demo      → fake checkout, no card fields, no money. Safe for showing the yeshiva.
# stripe    → real Stripe. sk_test_/pk_test_ keys = Stripe TEST mode; sk_live_/pk_live_ = real money.
PAYMENTS_MODE=demo

# ───────────── Stripe (only when PAYMENTS_MODE=stripe) ─────────────
# Must be the YESHIVA'S Stripe account. See docs/GO-LIVE.md.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ───────────── Storage ─────────────
# json (default, local files in .data/) or supabase (required for production)
STORE=json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ───────────── Admin (/admin) ─────────────
ADMIN_PASSWORD=
# 16+ random characters, e.g. `openssl rand -hex 24`
ADMIN_SESSION_SECRET=

# ───────────── Optional ─────────────
# Donation size bounds in cents of the campaign currency
MIN_DONATION_CENTS=100
MAX_DONATION_CENTS=10000000
# Bot protection: turnstile | hcaptcha
CAPTCHA_PROVIDER=
CAPTCHA_SECRET_KEY=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# Confirmation emails via Resend
RESEND_API_KEY=
MAIL_FROM=
